# Copy to .env for LOCAL development only. Never commit .env.
# In production inject these from a secret store (Key Vault / Secrets Manager / Vault).

# --- PostgreSQL source (read-only role, ideally a read replica). --
PGHOST=localhost
PGPORT=5432
PGDATABASE=retail
PGUSER=kg_reader
PGPASSWORD=
PGSSLMODE=prefer
PG_SCHEMAS=public

# --- Groq (Stage 6, optional; without a key the offline fixture is used) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional Neo4j target (Stage 16) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Runtime ---
KG_STORAGE_DIR=storage
KG_BATCH_SIZE=5000

# --- Uploaded CSV files (Stage 2 "Upload CSV files"; held in memory, never written to disk) ---
KG_MAX_UPLOAD_FILES=25
KG_MAX_UPLOAD_MB=25
KG_MAX_UPLOAD_ROWS=200000

# --- API authentication (JWT) ---
# Default login for local development. Swap for a users table later.
# The hash below is for the password "admin" - replace it for anything shared.
# Generate a hash: python -c "import bcrypt;print(bcrypt.hashpw(b'NEW_PASSWORD', bcrypt.gensalt()).decode())"
AUTH_DEFAULT_USERNAME=admin
AUTH_DEFAULT_PASSWORD_HASH='$2b$12$lFBlTSBVqPAvq.RQz5NYKOS8YmDcFC72kkQvcJORneyZLXyyNHjiS'
# Signing key: python -c "import secrets;print(secrets.token_urlsafe(48))"
# If empty, a random key is generated at each start (tokens stop working after a restart).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
