# Local development. Replace these example values before sharing the stack.
KG_WEB_PORT=8080
AUTH_DEFAULT_USERNAME=admin
# Local login password is admin. Single quotes preserve the bcrypt dollar signs.
AUTH_DEFAULT_PASSWORD_HASH='$2b$12$lFBlTSBVqPAvq.RQz5NYKOS8YmDcFC72kkQvcJORneyZLXyyNHjiS'
JWT_SECRET_KEY=local-development-signing-key-change-me

LOCAL_POSTGRES_ADMIN_PASSWORD=local-postgres-admin-change-me
LOCAL_POSTGRES_READER_PASSWORD=local-postgres-reader-change-me
# PG* defaults are used by the CLI. Use the same reader credentials in the UI.
PGHOST=postgres
PGPORT=5432
PGDATABASE=retail
PGUSER=kg_reader
PGPASSWORD=local-postgres-reader-change-me
PGSSLMODE=prefer
PG_SCHEMAS=public

LOCAL_NEO4J_PASSWORD=local-neo4j-change-me
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local-neo4j-change-me
NEO4J_DATABASE=neo4j
NEO4J_READ_USER=
NEO4J_READ_PASSWORD=
KG_META_DSN=
KG_GRAPH_ID_KEY=
KG_GRAPH_RETENTION_DAYS=30
GROQ_API_KEY=
KG_GRAPH_AI_ENABLED=false
KG_GRAPH_AI_MODEL=
